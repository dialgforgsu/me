# NOTE: GitHub Pages ignores this file. These headers only take effect if the site
# is served by Cloudflare Pages or Netlify (or Cloudflare in front of GitHub Pages
# with equivalent Transform Rules). Until then, the per-page <meta> CSP is the
# only header-like protection in place.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Images never change in place, so cache them for a long time.
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Scripts/styles aren't fingerprinted, so they must revalidate or visitors get stale code.
/*.js
  Cache-Control: public, max-age=300, must-revalidate

/*.css
  Cache-Control: public, max-age=300, must-revalidate

/*.json
  Cache-Control: no-cache

/*.pdf
  Cache-Control: public, max-age=86400
